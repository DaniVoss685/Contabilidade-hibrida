{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dental-finance-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dental-finance-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "3000",
        "--host",
        "0.0.0.0",
        "--strictPort"
      ],
      "port": 3000
    }
  ]
}